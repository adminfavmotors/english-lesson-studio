{
  "name": "a-better-life-lesson",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "content:build": "node --experimental-strip-types scripts/build-a1-course.mjs",
    "content:seed:sql": "node scripts/seed-library.mjs 0 30",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:database": "node --experimental-strip-types --test tests/database.integration.ts tests/material-catalogue.integration.ts tests/material-classification.integration.ts",
    "test:catalogue:browser": "node --experimental-strip-types --test tests/material-catalogue.browser.ts",
    "test:recovery": "node --experimental-strip-types --test tests/material-recovery.integration.ts",
    "test:invitations:browser": "node --experimental-strip-types --test tests/student-invitations.browser.ts",
    "test:library": "node --experimental-strip-types --test tests/materials.integration.ts",
    "test:cloud": "node --experimental-strip-types --test tests/cloud.integration.ts"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.1",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
